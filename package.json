{
  "name": "intervention-engine",
  "version": "0.1.0",
  "description": "A domain-agnostic evidence system for interventions: define a bounded taxonomy of actions, record their application, measure outcomes, and accumulate contextual evidence about what works where.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "intervention-engine-mcp": "./dist/mcp/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "demo": "tsx examples/marketing-demo.ts",
    "demo:collector": "tsx examples/collector-demo.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
